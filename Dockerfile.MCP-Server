FROM rockylinux:9.3

ARG PYTHON_VERSION=3.12

WORKDIR /app

# Install the runtime and network tools used by the health check.
RUN dnf install -y epel-release \
        && dnf install -y python${PYTHON_VERSION} python${PYTHON_VERSION}-pip git procps-ng lsof telnet screen iputils nmap-ncat \
        && dnf clean all \
        && update-alternatives --install /usr/bin/python python /usr/bin/python${PYTHON_VERSION} 1000 --slave /usr/bin/pip pip /usr/bin/pip${PYTHON_VERSION}

# Install the exact runtime dependency set used by CI and the MCPB bundle.
# Application source is mounted by Docker Compose at runtime.
COPY pyproject.toml uv.lock /tmp/deps/
RUN pip install --no-cache-dir 'uv==0.7.20' \
        && uv export --project /tmp/deps --locked --no-emit-project --no-hashes \
                -o /tmp/deps/requirements.txt \
        && pip install --no-cache-dir --no-deps -r /tmp/deps/requirements.txt \
        && rm -rf /tmp/deps

# Configure the Python runtime for mounted application source and live logs.
ENV PYTHONPATH=/app/src
ENV PYTHONUNBUFFERED=1

CMD ["/bin/bash", "/app/scripts/mcp-server-docker-cmd.sh"]
